# Postgres backend store for MLflow metadata, params, and metrics
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me

# MinIO root account
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# MLflow artifact storage (S3-compatible MinIO)
MLFLOW_S3_BUCKET=lyubava-mlflow-artifacts
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=us-east-1

# Used by local Python training code running on the host.
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# DVC remote storage (MinIO bucket s3://dvc). Uses the same MinIO credentials as above.
DVC_S3_ENDPOINT_URL=http://localhost:9000

# Used by the MLflow container inside docker-compose.
MLFLOW_SERVER_S3_ENDPOINT_URL=http://minio:9000
