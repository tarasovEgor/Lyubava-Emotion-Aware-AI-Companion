# Copy this file to k8s/minikube/.env and set local values before running
# kubectl apply -k k8s/minikube.

# FastAPI backend.
MODEL_DIR=/app/models/emotion_classifier
DRIFT_BASELINE_PATH=/app/monitoring/baselines/drift-baseline.json
DRIFT_WINDOW_SIZE=500
DRIFT_MIN_SAMPLES=100
PREDICTIONS_FEED_MAX_ITEMS=500
CHAT_TEMPERATURE=0.7
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b
# Leave empty if the frontend is built with VITE_CHAT_MOCK=true.
OPENROUTER_API_KEY=

# Postgres backend store for MLflow.
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
PGDATA=/var/lib/postgresql/data/pgdata

# MinIO root account.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# MLflow artifact storage in MinIO.
MLFLOW_S3_BUCKET=lyubava-mlflow-artifacts
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=us-east-1

# Grafana admin account.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GF_USERS_ALLOW_SIGN_UP=false
